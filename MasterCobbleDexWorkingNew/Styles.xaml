<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Button style -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="#2F2F2F"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="/Fonts/#Pokemon Fire Red"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#727272"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#727272"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Label style -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="/Fonts/#Pokemon Fire Red"/>
    </Style>
    <!-- Label style -->
    <Style x:Key="LabelShadow" TargetType="Label">
        <Setter Property="FontFamily" Value="/Fonts/#Pokemon Fire Red"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="3.75" Opacity="1"/>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Text Block style -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="/Fonts/#Pokemon Fire Red"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>
    
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="/Fonts/#Pokemon Fire Red"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>


</ResourceDictionary>