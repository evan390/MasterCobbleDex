<Window x:Class="MasterCobbleDexWorkingNew.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterCobbleDexWorkingNew"
        mc:Ignorable="d"
        Title="MasterCobbleDex" Height="450" Width="800">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition  Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Add Content" Grid.Row="0" Grid.Column="1" Click="Add_Content_Click" x:Name="btnAddContent"/>
            <Button Content="Edit Loaded Content" Grid.Row="0" Grid.Column="0" Click="btnPanelSwitch_Click" x:Name="btnPanelSwitch"/>
            <Button Content="Create MasterDex"  Grid.Row="0" Grid.Column="1" Click="Button_Click" x:Name="btnCreateDex"/>

            <Grid x:Name="grdEdit" Grid.Row="1" Grid.ColumnSpan="2" Background="IndianRed" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="grdOptions">

                </Grid>
                <Grid x:Name="grdSelections" Grid.Column="2">
                    <ScrollViewer>
                        <Grid x:Name="grdMods">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                            </Grid.RowDefinitions>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="grdDex" Grid.Row="1" Grid.ColumnSpan="2" Background="LightBlue" Panel.ZIndex="-1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="grdPokemon">
                    <Grid.RowDefinitions>
                        <RowDefinition  Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="txtSearchPokemon" TextChanged="txtSearchPokemon_TextChanged"/>
                    <DataGrid
                        Grid.Row="1"
                        x:Name="dtgPokemon"
                        IsReadOnly="true"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        SelectionMode="Single"
                        AutoGenerateColumns="False"
                        SelectionChanged="dtgPokemon_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pokemon" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <Viewbox Grid.Column="1" Grid.ColumnSpan="2" >
                    <Grid x:Name="grdInfo"  Height="450" Width="670">
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="55"/>
                            <RowDefinition  Height="*"/>
                            <RowDefinition  Height="36"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="grdHeader" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="lblName" Content="" FontSize="32"/>
                            <Label FontSize="20" Content="Form:" Grid.Column="1"/>
                            <ComboBox x:Name="cboForm" FontSize="20" Grid.Column="2" SelectionChanged="cboForm_SelectionChanged" ItemsSource="{Binding Pokemon}" DisplayMemberPath="Form">
                            </ComboBox>

                        </Grid>
                        <Grid x:Name="grdButtons" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="General" x:Name="btnGeneral" Grid.Column="0" Click="btnGeneral_Click"/>
                            <Button Content="Learnset" x:Name="btnLearnset" Grid.Column="1" Click="btnLearnset_Click"/>
                            <Button Content="Drops" x:Name="btnDrops" Grid.Column="2" Click="btnDrops_Click"/>
                            <Button Content="Evolutions" x:Name="btnEvolutions" Grid.Column="3" Click="btnEvolutions_Click"/>
                        </Grid>
                        <Grid x:Name="grdGeneralInfo" Grid.Row="1" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition  Height="36"/>
                                <RowDefinition  Height="36"/>
                                <RowDefinition  Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label FontSize="20" Content="Type:"/>
                                <Label FontSize="20" Content="" Grid.Column="1" x:Name="lblTypeOne"/>
                                <Label FontSize="20" Content="" Grid.Column="2" x:Name="lblTypeTwo"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label FontSize="20" Content="♂:"/>
                                <Label FontSize="20" Content="" Grid.Column="1" x:Name="lblGenderMale"/>
                                <Label FontSize="20" Content="♀:" Grid.Column="2"/>
                                <Label FontSize="20" Content="" Grid.Column="3" x:Name="lblGenderFemale"/>
                            </Grid>

                            <Grid  Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label FontSize="20" Content="Egg Groups:"/>
                                <Label FontSize="18" Content="" Grid.Column="1" x:Name="lblEggGroups"/>
                            </Grid>
                            <Label Grid.Row="3" Content="possible render if i figure that out"/>
                            <Grid Grid.Column="1" Grid.RowSpan="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition  Height="50"/>
                                    <RowDefinition  Height="35"/>
                                    <RowDefinition  Height="35"/>
                                    <RowDefinition  Height="35"/>
                                    <RowDefinition  Height="35"/>
                                    <RowDefinition  Height="50"/>
                                    <RowDefinition  Height="35"/>
                                    <RowDefinition  Height="35"/>
                                    <RowDefinition  Height="35"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Base Stats" FontSize="28" Grid.ColumnSpan="4"/>
                                <Label FontSize="16" Content="HP:" Grid.Row="1" Grid.Column="0"/>
                                <Label FontSize="16" Content="Attack:" Grid.Row="2" Grid.Column="0"/>
                                <Label FontSize="16" Content="Defense:" Grid.Row="3" Grid.Column="0"/>
                                <Label FontSize="16" Content="S. Attack:" Grid.Row="1" Grid.Column="2"/>
                                <Label FontSize="16" Content="S. Defense:" Grid.Row="2" Grid.Column="2"/>
                                <Label FontSize="16" Content="Speed:" Grid.Row="3" Grid.Column="2"/>
                                <Label FontSize="16" Content="Total:" Grid.Row="4" Grid.Column="0"/>
                                <Label FontSize="16" Content="" Grid.Row="1" Grid.Column="1" x:Name="lblHP"/>
                                <Label FontSize="16" Content="" Grid.Row="2" Grid.Column="1" x:Name="lblAttack"/>
                                <Label FontSize="16" Content="" Grid.Row="3" Grid.Column="1" x:Name="lblDefense"/>
                                <Label FontSize="16" Content="" Grid.Row="1" Grid.Column="3" x:Name="lblSpecialAttack"/>
                                <Label FontSize="16" Content="" Grid.Row="2" Grid.Column="3" x:Name="lblSpecialDefense"/>
                                <Label FontSize="16" Content="" Grid.Row="3" Grid.Column="3" x:Name="lblSpeed"/>
                                <Label FontSize="16" Content="" Grid.Row="4" Grid.Column="1" x:Name="lblTotal"/>

                                <Label Content="EV Yield" FontSize="28" Grid.ColumnSpan="4" Grid.Row="5"/>
                                <Label Content="Base Stats" FontSize="28" Grid.ColumnSpan="4"/>
                                <Label FontSize="16" Content="HP:" Grid.Row="6" Grid.Column="0"/>
                                <Label FontSize="16" Content="Attack:" Grid.Row="7" Grid.Column="0"/>
                                <Label FontSize="16" Content="Defense:" Grid.Row="8" Grid.Column="0"/>
                                <Label FontSize="16" Content="S. Attack:" Grid.Row="6" Grid.Column="2"/>
                                <Label FontSize="16" Content="S. Defense:" Grid.Row="7" Grid.Column="2"/>
                                <Label FontSize="16" Content="Speed:" Grid.Row="8" Grid.Column="2"/>
                                <Label FontSize="16" Content="" Grid.Row="6" Grid.Column="1" x:Name="lblHPEV"/>
                                <Label FontSize="16" Content="" Grid.Row="7" Grid.Column="1" x:Name="lblAttackEV"/>
                                <Label FontSize="16" Content="" Grid.Row="8" Grid.Column="1" x:Name="lblDefenseEV"/>
                                <Label FontSize="16" Content="" Grid.Row="6" Grid.Column="3" x:Name="lblSpecialAttackEV"/>
                                <Label FontSize="16" Content="" Grid.Row="7" Grid.Column="3" x:Name="lblSpecialDefenseEV"/>
                                <Label FontSize="16" Content="" Grid.Row="8" Grid.Column="3" x:Name="lblSpeedEV"/>
                            </Grid>
                        </Grid>
                        <Grid x:Name="grdLearnsetInfo" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition  Height="40"/>
                                <RowDefinition  Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Abilties:" FontSize="18" Grid.Column="0"/>
                                <Label Content="" FontSize="18" Grid.Column="1" x:Name="lblAbilities"/>
                                <Label Content="Hidden Abilties:" FontSize="18" Grid.Column="2"/>
                                <Label Content="" FontSize="18" Grid.Column="3" x:Name="lblHiddenAbilities"/>

                            </Grid>
                            <DataGrid Grid.Row="1" x:Name="dtgMoves"
                                IsReadOnly="true"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                SelectionMode="Single"
                                AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Learn Type" Binding="{Binding MoveType}" Width="100"/>
                                    <DataGridTextColumn Header="Move" Binding="{Binding MoveName}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <Grid x:Name="grdDropsInfo" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition  Height="*"/>
                            </Grid.RowDefinitions>

                        </Grid>
                        <ScrollViewer x:Name="scrEvolutionsInfo" Grid.Row="1" Visibility="Collapsed">
                            <Grid x:Name="grdEvolutionsInfo">
                                <Grid.RowDefinitions>
                                    <RowDefinition  Height="*"/>
                                </Grid.RowDefinitions>

                            </Grid>
                        </ScrollViewer>

                    </Grid>

                </Viewbox>
            </Grid>
        </Grid>

    </Grid>
</Window>
