<Window x:Class="MasterCobbleDexWorkingNew.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterCobbleDexWorkingNew"
        mc:Ignorable="d"
        Title="MasterCobbleDex" Height="450" Width="800">
    <Grid>
        <Border Background="#BA3A30">
            <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition  Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Edit Loaded Content" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Click="btnPanelSwitch_Click" x:Name="btnPanelSwitch"/>
            <Grid x:Name="grdEdit" Grid.Row="1" Grid.ColumnSpan="2" Background="#BA3A30" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="grdOptions">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="Create MasterDex"  Grid.Row="1" Click="Button_Click" x:Name="btnCreateDex" HorizontalAlignment="Center" Width="200" VerticalAlignment="Center" Height="50"/>
                    <Button Content="Add Content" Grid.Row="2" Click="Add_Content_Click" x:Name="btnAddContent" HorizontalAlignment="Center" Width="200" VerticalAlignment="Center" Height="50"/>
                    <Button Content="Remove Deselected"  Grid.Row="3" Click="btnRemoveDeselected_Click" x:Name="btnRemoveDeselected" HorizontalAlignment="Center" Width="200" VerticalAlignment="Center" Height="50"/>
                    <Button Content="Change Directory"  Grid.Row="4" Click="btnChangeDirectory_Click" x:Name="btnChangeDirectory" HorizontalAlignment="Center" Width="200" VerticalAlignment="Center" Height="50"/>

                </Grid>
                    <Border  Grid.Column="1" Background="#C0CED6" Margin="10" CornerRadius="10">
                        <Grid x:Name="grdSelections" Margin="15"  Background="#D3D3D3" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="chkAll" Content="All" IsChecked="True" Click="chkAll_Click" Margin="5" VerticalAlignment="Center"/>
                        <ScrollViewer Grid.Row="1"   Background="#E2E2E2">
                            <Grid x:Name="grdMods">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="grdDex" Grid.Row="1" Grid.ColumnSpan="2" Background="#BA3A30" Panel.ZIndex="-1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="grdPokemon" Margin="0, 5, 0, 5">
                    <Grid.RowDefinitions>
                        <RowDefinition  Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox SelectedIndex="0" x:Name="cboSearchCategory" SelectionChanged="cboSearchCategory_SelectionChanged">
                            <ComboBoxItem>Name</ComboBoxItem>
                            <ComboBoxItem>Form</ComboBoxItem>
                            <ComboBoxItem>Type</ComboBoxItem>
                            <ComboBoxItem>Move</ComboBoxItem>
                            <ComboBoxItem>Ability</ComboBoxItem>
                            <ComboBoxItem>Drop</ComboBoxItem>
                            
                        </ComboBox>
                        <TextBox x:Name="txtSearchPokemon" TextChanged="txtSearchPokemon_TextChanged" Grid.Column="1" FontFamily="/Fonts/#Pokemon Fire Red" FontSize="20" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Search..."  Grid.Column="1"  FontFamily="/Fonts/#Pokemon Fire Red" FontSize="20" Foreground="Gray" Margin="3,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtSearchPokemon}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </Grid>
                    <DataGrid
                        Grid.Row="1"
                        x:Name="dtgPokemon"
                        IsReadOnly="true"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        SelectionMode="Single"
                        AutoGenerateColumns="False"
                        SelectionChanged="dtgPokemon_SelectionChanged"
                        FontFamily="/Fonts/#Pokemon Fire Red"
                        FontSize="20"
                        HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pokemon" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                    <Border Grid.Column="1" Grid.ColumnSpan="2" Background="#BA3A30">
                        <Viewbox Margin="5">
                            <Border Background="#C0CED6" CornerRadius="10">
                                <Grid x:Name="grdInfo"  Height="450" Width="670" Background="LightBlue" Margin="15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition  Height="55"/>
                                        <RowDefinition  Height="*"/>
                                        <RowDefinition  Height="45"/>
                                    </Grid.RowDefinitions>
                                    <Grid x:Name="grdHeader" Grid.Row="0" Background="#3A96B6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <Label x:Name="lblName" Content="" FontSize="48" Margin="5, 0" Foreground="White">
                                            <Label.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="4" Opacity="1"/>
                                            </Label.Effect>
                                        </Label>
                                        <Label FontSize="30" Content="Form:" Grid.Column="1" VerticalAlignment="Center" Foreground="White"/>
                                        <ComboBox x:Name="cboForm" FontSize="30" Grid.Column="2" SelectionChanged="cboForm_SelectionChanged" ItemsSource="{Binding Pokemon}" DisplayMemberPath="Form" Height="40" VerticalAlignment="Center" Width="170" HorizontalAlignment="Left">
                                        </ComboBox>

                                    </Grid>
                                    <Grid x:Name="grdButtons" Grid.Row="2" Background="#C0CED6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="General" x:Name="btnGeneral" Grid.Column="0" Width="125" Height="35" VerticalAlignment="Bottom" Click="btnGeneral_Click"/>
                                        <Button Content="Learnset" x:Name="btnLearnset" Grid.Column="1" Width="125" Height="35" VerticalAlignment="Bottom" Click="btnLearnset_Click"/>
                                        <Button Content="Drops" x:Name="btnDrops" Grid.Column="2" Width="125" Height="35" VerticalAlignment="Bottom" Click="btnDrops_Click"/>
                                        <Button Content="Evolutions" x:Name="btnEvolutions" Grid.Column="3" Width="125" Height="35" VerticalAlignment="Bottom" Click="btnEvolutions_Click"/>
                                        <Button Content="Spawns" x:Name="btnSpawns" Grid.Column="4" Width="125" Height="35" VerticalAlignment="Bottom" Click="btnSpawns_Click"/>
                                    </Grid>
                                    <Grid x:Name="grdGeneralInfo" Grid.Row="1" Visibility="Visible" Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition  Height="60"/>
                                            <RowDefinition  Height="46"/>
                                            <RowDefinition  Height="60"/>
                                            <RowDefinition  Height="46"/>
                                            <RowDefinition  Height="60"/>
                                            <RowDefinition  Height="36"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Background="#3A96B6" Margin="5, 10, 15, 0">
                                            <Label FontSize="42" Content="Type" Style="{StaticResource LabelShadow}" />
                                        </Border>
                                        <Border Grid.Row="1" Margin="15, 0, 25, 0" Background="#E2E2E2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="158"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <Label FontSize="30" Content="" Grid.Column="0" x:Name="lblTypeOne"/>
                                                <Label FontSize="30" Content="" Grid.Column="1" x:Name="lblTypeTwo"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="#3A96B6" Grid.Row="2" Margin="5, 10, 15, 0">
                                            <Label FontSize="42" Grid.Row="2" Content="Gender" Style="{StaticResource LabelShadow}"/>
                                        </Border>


                                        <Border Grid.Row="3" Margin="15, 0, 25, 0" Background="#E2E2E2">
                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="/images/male.png" Margin="7"/>
                                                <Label FontSize="24" Content="" Grid.Column="1" x:Name="lblGenderMale" VerticalAlignment="Center"/>
                                                <Image Source="/images/female.png" Grid.Column="2" Margin="7"/>
                                                <Label FontSize="24" Content="" Grid.Column="3" x:Name="lblGenderFemale" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>


                                        <Border Background="#3A96B6" Grid.Row="4" Margin="5, 10, 15, 0">
                                            <Label FontSize="42" Grid.Row="4" Content="Egg Groups" Style="{StaticResource LabelShadow}"/>
                                        </Border>


                                        <Border Grid.Row="5" Margin="15, 0, 25, 0" Background="#E2E2E2">
                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label FontSize="30" Content="" Grid.Column="1" x:Name="lblEggGroups" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        
                                        <Grid Grid.Column="1" Grid.RowSpan="9">
                                            <Grid.RowDefinitions>
                                                <RowDefinition  Height="60"/>
                                                <RowDefinition  Height="30"/>
                                                <RowDefinition  Height="30"/>
                                                <RowDefinition  Height="30"/>
                                                <RowDefinition  Height="30"/>
                                                <RowDefinition  Height="60"/>
                                                <RowDefinition  Height="30"/>
                                                <RowDefinition  Height="30"/>
                                                <RowDefinition  Height="30"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Background="#3A96B6" Grid.ColumnSpan="4" Margin="0, 10, 15, 0">
                                                <Label Content="Base Stats" FontSize="42" Style="{StaticResource LabelShadow}"/>
                                            </Border>

                                            <Border Grid.Row="1" Grid.ColumnSpan="4" Grid.RowSpan="4" Margin="10, 0, 25, 0" Background="#E2E2E2"/>

                                            <Label FontSize="24" Content="HP:" Grid.Row="1" Grid.Column="0" Margin="10, 0, 0, 0"/>
                                            <Label FontSize="24" Content="Attack:" Grid.Row="2" Grid.Column="0" Margin="10, 0, 0, 0"/>
                                            <Label FontSize="24" Content="Defense:" Grid.Row="3" Grid.Column="0" Margin="10, 0, 0, 0"/>
                                            <Label FontSize="24" Content="S. Attack:" Grid.Row="1" Grid.Column="2" Margin="10, 0, 0, 0"/>
                                            <Label FontSize="24" Content="S. Defense:" Grid.Row="2" Grid.Column="2" Margin="10, 0, 0, 0"/>
                                            <Label FontSize="24" Content="Speed:" Grid.Row="3" Grid.Column="2" Margin="10, 0, 0, 0"/>
                                            <Label FontSize="24" Content="Total:" Grid.Row="4" Grid.Column="0" Margin="10, 0, 0, 0"/>
                                            <Label FontSize="24" Content="" Grid.Row="1" Grid.Column="1" x:Name="lblHP"/>
                                            <Label FontSize="24" Content="" Grid.Row="2" Grid.Column="1" x:Name="lblAttack"/>
                                            <Label FontSize="24" Content="" Grid.Row="3" Grid.Column="1" x:Name="lblDefense"/>
                                            <Label FontSize="24" Content="" Grid.Row="1" Grid.Column="3" x:Name="lblSpecialAttack"/>
                                            <Label FontSize="24" Content="" Grid.Row="2" Grid.Column="3" x:Name="lblSpecialDefense"/>
                                            <Label FontSize="24" Content="" Grid.Row="3" Grid.Column="3" x:Name="lblSpeed"/>
                                            <Label FontSize="24" Content="" Grid.Row="4" Grid.Column="1" x:Name="lblTotal"/>


                                            <Border Background="#3A96B6"  Grid.ColumnSpan="4" Grid.Row="5" Margin="0, 10, 15, 0">
                                                <Label Content="EV Yield" FontSize="42" Style="{StaticResource LabelShadow}"/>
                                            </Border>
                                            
                                            <Border Grid.Row="6" Grid.ColumnSpan="4" Grid.RowSpan="3" Margin="10, 0, 25, 0" Background="#E2E2E2"/>
                                            
                                            <Label FontSize="24" Content="HP:" Grid.Row="6" Grid.Column="0" Margin="10, 0, 0, 0"/>
                                            <Label FontSize="24" Content="Attack:" Grid.Row="7" Grid.Column="0" Margin="10, 0, 0, 0"/>
                                            <Label FontSize="24" Content="Defense:" Grid.Row="8" Grid.Column="0" Margin="10, 0, 0, 0"/>
                                            <Label FontSize="24" Content="S. Attack:" Grid.Row="6" Grid.Column="2" Margin="10, 0, 0, 0"/>
                                            <Label FontSize="24" Content="S. Defense:" Grid.Row="7" Grid.Column="2" Margin="10, 0, 0, 0"/>
                                            <Label FontSize="24" Content="Speed:" Grid.Row="8" Grid.Column="2" Margin="10, 0, 0, 0"/>
                                            <Label FontSize="24" Content="" Grid.Row="6" Grid.Column="1" x:Name="lblHPEV"/>
                                            <Label FontSize="24" Content="" Grid.Row="7" Grid.Column="1" x:Name="lblAttackEV"/>
                                            <Label FontSize="24" Content="" Grid.Row="8" Grid.Column="1" x:Name="lblDefenseEV"/>
                                            <Label FontSize="24" Content="" Grid.Row="6" Grid.Column="3" x:Name="lblSpecialAttackEV"/>
                                            <Label FontSize="24" Content="" Grid.Row="7" Grid.Column="3" x:Name="lblSpecialDefenseEV"/>
                                            <Label FontSize="24" Content="" Grid.Row="8" Grid.Column="3" x:Name="lblSpeedEV"/>
                                        </Grid>
                                    </Grid>
                                    <Grid x:Name="grdLearnsetInfo" Grid.Row="1" Visibility="Collapsed" Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition  Height="100"/>
                                            <RowDefinition  Height="191"/>
                                            <RowDefinition  Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Background="#3A96B6" Margin="0, 0, 0, 5">
                                                <Label Content="Abilties:" FontSize="27" Grid.Column="0" VerticalAlignment="Center" Foreground="White">
                                                    <Label.Effect>
                                                        <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="2.25" Opacity="1"/>
                                                    </Label.Effect>
                                                </Label>
                                            </Border>

                                            <Border Grid.Column="1" Margin="0, 0, 0, 5" Background="#E2E2E2">
                                                <Grid x:Name="grdAbilities">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition  Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="2" Background="#3A96B6" Margin="0, 0, 0, 5"/>


                                            <Border Grid.Column="3" Margin="0, 0, 0, 5" Background="#E2E2E2">
                                                <TextBlock FontSize="24" Margin="5, 2" TextWrapping="Wrap" x:Name="blkAbilityInfo" FontFamily="/Fonts/#Pokemon Fire Red"></TextBlock>
                                            </Border>

                                        </Grid>
                                        <DataGrid Grid.Row="1" x:Name="dtgMoves"
                                        IsReadOnly="true"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        SelectionMode="Single"
                                        AutoGenerateColumns="False"
                                        SelectionChanged="dtgMoves_SelectionChanged"
                                        FontFamily="/Fonts/#Pokemon Fire Red"
                                        FontSize="20"
                                        HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Learn Type" Binding="{Binding MoveType}" Width="100"/>
                                                <DataGridTextColumn Header="Move" Binding="{Binding MoveName}" Width="120"/>
                                                <DataGridTextColumn Header="Base Power" Binding="{Binding BasePower}" Width="80"/>
                                                <DataGridTextColumn Header="Accuracy" Binding="{Binding Accuracy}" Width="80"/>
                                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="80"/>
                                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                                                <DataGridTextColumn Header="PP" Binding="{Binding PP}" Width="25"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Border Grid.Row="2" Margin="0, 0, 0, 0" Background="#E2E2E2">
                                            <TextBlock Grid.Row="2" Margin="5, 2" TextWrapping="Wrap" x:Name="blkMoveDescription" FontSize="24" FontFamily="/Fonts/#Pokemon Fire Red"></TextBlock>
                                        </Border>
                                    </Grid>
                                    <Grid x:Name="grdDropsInfo" Grid.Row="1" Visibility="Collapsed" Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition  Height="*"/>
                                        </Grid.RowDefinitions>

                                    </Grid>
                                    <ScrollViewer x:Name="scrEvolutionsInfo" Grid.Row="1" Visibility="Collapsed" Margin="5">
                                        <Grid x:Name="grdEvolutionsInfo">
                                            <Grid.RowDefinitions>
                                                <RowDefinition  Height="*"/>
                                            </Grid.RowDefinitions>

                                        </Grid>
                                    </ScrollViewer>
                                    <ScrollViewer x:Name="scrSpawnsInfo" Grid.Row="1" Visibility="Collapsed" Margin="5">
                                        <Grid x:Name="grdSpawnsInfo">
                                            <Grid.RowDefinitions>
                                                <RowDefinition  Height="*"/>
                                            </Grid.RowDefinitions>

                                        </Grid>
                                    </ScrollViewer>

                                </Grid>
                            </Border>
                        </Viewbox>
                    </Border>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
